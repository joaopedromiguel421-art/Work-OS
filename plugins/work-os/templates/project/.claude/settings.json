{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git push --force*)",
      "Bash(*--dangerously-skip-permissions*)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npx *)",
      "Bash(npm publish*)",
      "Bash(pnpm add*)",
      "Bash(yarn add*)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(*deploy*)",
      "Bash(*migrate*)"
    ]
  },
  "disableAllHooks": false,
  "disableWorkflows": true,
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": []
}
